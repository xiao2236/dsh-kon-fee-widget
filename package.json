{
  "name": "dsh-kon-fee-widget",
  "version": "0.17.0",
  "description": "DSH 上的《轻音少女》部费挂件：用原版茶桌当底座，五个人坐满；点一下才弹账本——DeepSeek 余额 + 峰谷时段 + 更新时间。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test test/core.test.mjs test/host.test.mjs",
    "test": "node scripts/build-client.mjs && node scripts/check.mjs && node --test test/core.test.mjs test/host.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "k-on",
    "balance",
    "widget"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "dsh-kon-fee-widget contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao2236/dsh-kon-fee-widget.git"
  },
  "homepage": "https://github.com/xiao2236/dsh-kon-fee-widget",
  "bugs": {
    "url": "https://github.com/xiao2236/dsh-kon-fee-widget/issues"
  }
}
